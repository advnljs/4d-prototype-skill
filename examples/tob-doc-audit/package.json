{
  "name": "tob-doc-audit",
  "private": true,
  "version": "0.1.0",
  "description": "4d-prototype toB 示例：集团财务共享中心收付款单据智能核查（规则引擎 + 模拟智能体 + 4D 全流程演示，数据全部虚构）",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5280 --strictPort",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
