{
  "name": "toc-food-delivery",
  "private": true,
  "version": "0.1.0",
  "description": "4d-prototype toC 示例：虚构即时配送平台“橙子到家”一单外卖从下单到结算的三端联动 4D 原型（数据全部虚构）",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5290 --strictPort",
    "dev:lan": "vite --port 5290 --strictPort --host",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview --port 5291 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
